# Targets live in config/targets/targets.yml. Uncomment for a quick plain-URL override:
# PING_TARGET_URLS=https://google.com,https://github.com
PING_AGENT_PORT=18080
API_GATEWAY_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
PROMETHEUS_QUERY_CACHE_SECONDS=15
# Alert receivers live in a git-ignored copy of config/alertmanager.yml (see docs/ALERTING.md):
# ALERTMANAGER_CONFIG=./config/alertmanager.local.yml
